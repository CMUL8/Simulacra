# Copy to .env and fill in values. Never commit .env.
OPENROUTER_API_KEY=
SIMULACRA_USE_PRIME=1
SIMULACRA_PRIME_PROVIDER=openrouter
SIMULACRA_PRIME_MODEL=anthropic/claude-3-haiku
SIMULACRA_SANDBOX=auto
SIMULACRA_DEFAULT_TENANT=default

# Multi-user / enterprise
SIMULACRA_AUTH_REQUIRED=1
SIMULACRA_BOOTSTRAP_EMAIL=admin@localhost
SIMULACRA_BOOTSTRAP_PASSWORD=simulacra-admin-change-me

# Optional when Docker is installed:
# SIMULACRA_SANDBOX=docker
# SIMULACRA_SANDBOX_IMAGE=python:3.12-slim
