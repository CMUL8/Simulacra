# Copy to .env and fill in values. Never commit .env.
OPENROUTER_API_KEY=
SIMULACRA_USE_PRIME=1
SIMULACRA_PRIME_PROVIDER=openrouter
SIMULACRA_PRIME_MODEL=deepseek/deepseek-v4-pro
# Optional override for builder runs only (falls back to SIMULACRA_PRIME_MODEL)
# SIMULACRA_BUILD_MODEL=deepseek/deepseek-v4-pro
# Absolute share URLs in Ship chat (also uses RAILWAY_PUBLIC_DOMAIN when set)
# SIMULACRA_PUBLIC_BASE=https://your-app.up.railway.app
SIMULACRA_SANDBOX=auto
SIMULACRA_DEFAULT_TENANT=default

# Multi-user / enterprise
SIMULACRA_AUTH_REQUIRED=1
SIMULACRA_BOOTSTRAP_EMAIL=admin@localhost
SIMULACRA_BOOTSTRAP_PASSWORD=simulacra-admin-change-me

# Postgres identity store (unset = local JSON under data/)
# SIMULACRA_DATABASE_URL=postgresql://simulacra:simulacra@127.0.0.1:5432/simulacra

# Sandbox / ephemeral machines
# SIMULACRA_SANDBOX=auto|docker|gvisor|machine|worktree
# SIMULACRA_MACHINE_PROVIDER=local|fly
# SIMULACRA_MACHINE_GVISOR=1
# SIMULACRA_GVISOR_RUNTIME=runsc
# SIMULACRA_SANDBOX_IMAGE=python:3.12-slim
# FLY_API_TOKEN=
# SIMULACRA_FLY_APP=
# SIMULACRA_FLY_REGION=iad
# SIMULACRA_FLY_IMAGE=

# SIEM export / forwarder
# SIMULACRA_SIEM_WEBHOOK=https://siem.example/ingest
# SIMULACRA_SIEM_FORMAT=json|cef|hec
# SIMULACRA_SIEM_TOKEN=

# CMUL8 Clerk (platform.cmul8.com)
# CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# VITE_CLERK_PUBLISHABLE_KEY=
# CLERK_FRONTEND_API=https://clerk.platform.cmul8.com
