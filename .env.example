# Copy to .env and fill in values. Never commit .env.
OPENAI_API_KEY=
CMUL8_AGENT_HARNESS=codex
CMUL8_MODEL_PROVIDER=openai
# Optional Codex model/profile overrides. Defaults use the signed-in/API account defaults.
# CMUL8_MODEL=gpt-5.3-codex
# CMUL8_MODEL_REASONING_EFFORT=high
# CMUL8_CODEX_PROFILE=
# Operator-only open-model route. The endpoint must implement the OpenAI Responses API.
# CMUL8_MODEL_PROVIDER=custom
# CMUL8_MODEL_BASE_URL=https://models.example.com/v1
# CMUL8_MODEL_API_KEY_ENV=CMUL8_MODEL_API_KEY
# CMUL8_MODEL_API_KEY=
# CMUL8_MODEL=gpt-oss-120b
# Absolute share URLs in Ship chat (also uses RAILWAY_PUBLIC_DOMAIN when set)
# SIMULACRA_PUBLIC_BASE=https://your-app.up.railway.app
SIMULACRA_SANDBOX=auto
SIMULACRA_DEFAULT_TENANT=default

# Multi-user / enterprise
SIMULACRA_AUTH_REQUIRED=1
SIMULACRA_BOOTSTRAP_EMAIL=admin@localhost
SIMULACRA_BOOTSTRAP_PASSWORD=

# Required by the single-VM Docker Compose deployment. Use long random values.
CMUL8_POSTGRES_PASSWORD=
CMUL8_TENANT_ID=default
CMUL8_ENVIRONMENT=production
CMUL8_BIND_ADDRESS=127.0.0.1
CMUL8_PORT=8000
# Set to a digest-pinned registry image in staging/production.
# CMUL8_IMAGE=registry.example/cmul8@sha256:...

# Postgres identity store (unset = local JSON under data/)
# SIMULACRA_DATABASE_URL=postgresql://simulacra:simulacra@127.0.0.1:5432/simulacra

# Sandbox / ephemeral machines
# SIMULACRA_SANDBOX=auto|docker|gvisor|machine|worktree
# SIMULACRA_MACHINE_PROVIDER=local|fly
# SIMULACRA_MACHINE_GVISOR=1
# SIMULACRA_GVISOR_RUNTIME=runsc
# SIMULACRA_SANDBOX_IMAGE=python:3.12-slim
# FLY_API_TOKEN=
# SIMULACRA_FLY_APP=
# SIMULACRA_FLY_REGION=iad
# SIMULACRA_FLY_IMAGE=

# SIEM export / forwarder
# SIMULACRA_SIEM_WEBHOOK=https://siem.example/ingest
# SIMULACRA_SIEM_FORMAT=json|cef|hec
# SIMULACRA_SIEM_TOKEN=

# CMUL8 Clerk (platform.cmul8.com)
# CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# VITE_CLERK_PUBLISHABLE_KEY=
# CLERK_FRONTEND_API=https://clerk.platform.cmul8.com

# Firecrawl — PDF / DOCX / XLSX parse into markdown for extract (optional)
# https://docs.firecrawl.dev/features/parse
# FIRECRAWL_API_KEY=fc-...
