{
  "format": "cmul8.oci-process-contract.v1",
  "image": {
    "entrypoint": ["/opt/cmul8/bin/cmul8-entrypoint"],
    "processArgument": "exactly one of web, api, worker, preflight, doctor, migrations, smoke",
    "requiredLabels": [
      "org.opencontainers.image.revision",
      "org.opencontainers.image.source",
      "org.opencontainers.image.version"
    ],
    "runAsNonRoot": true,
    "readOnlyRootFilesystem": true,
	"writableMounts": ["/tmp", "/app/data", "/app/runs"]
  },
  "processes": {
    "api": {
      "command": ["/opt/cmul8/bin/cmul8-api"],
      "port": 8000,
      "health": "/healthz",
      "readiness": "/readyz"
    },
    "web": {
      "command": ["/opt/cmul8/bin/cmul8-web"],
      "port": 8080,
      "health": "/healthz",
      "readiness": "/readyz"
    },
    "worker": {
      "command": ["/opt/cmul8/bin/cmul8-worker"],
      "health": {
        "liveness": ["/opt/cmul8/bin/cmul8-worker-health", "--live"],
        "readiness": ["/opt/cmul8/bin/cmul8-worker-health", "--ready"],
        "contract": "must test the running worker and queue-consumption readiness; marker-file-only implementations are forbidden"
      }
    },
    "preflight": {
      "command": ["/opt/cmul8/bin/cmul8-preflight"],
      "checks": ["environment-contract", "postgres", "redis", "object-storage", "secret-provider"],
	  "lifecycle": "compose one-shot dependency before migrations",
      "restartPolicy": "Never"
    },
    "doctor": {
      "command": ["/opt/cmul8/bin/cmul8-doctor", "--format", "human"],
      "checks": ["environment", "single-tenant", "authentication", "postgres", "redis", "storage", "executor", "recovery"],
      "lifecycle": "operator-run production approval check",
      "restartPolicy": "Never"
    },
    "migrations": {
      "command": ["/opt/cmul8/bin/cmul8-migrate"],
	  "lifecycle": "compose one-shot dependency before application start",
      "restartPolicy": "Never"
    },
    "smoke": {
      "command": ["/opt/cmul8/bin/cmul8-smoke"],
      "checks": ["api", "worker", "queue", "storage", "connectors"],
	  "lifecycle": "operator-run check after install, upgrade, or rollback",
      "restartPolicy": "Never"
    }
  },
  "shutdown": {"signal": "SIGTERM", "gracePeriodSeconds": 30}
}
