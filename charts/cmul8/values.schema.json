{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["deploymentMode", "tenantId", "environment", "image", "external"],
  "properties": {
    "deploymentMode": {"enum": ["cmul8_cloud", "dedicated_cloud", "private_cloud"]},
    "tenantId": {"type": "string", "minLength": 2},
    "environment": {"type": "string", "minLength": 2},
    "image": {
      "type": "object",
      "required": ["repository", "digest"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "external": {
      "type": "object",
      "required": ["secretName", "postgresKey", "redisKey", "objectStorageKey"],
      "properties": {"secretName": {"type": "string", "minLength": 1}}
    },
    "disruptionBudget": {
      "type": "object",
      "required": ["enabled", "maxUnavailable"],
      "properties": {
        "enabled": {"type": "boolean"},
        "maxUnavailable": {"type": "integer", "minimum": 0}
      }
    },
    "topologySpread": {
      "type": "object",
      "required": ["enabled", "maxSkew", "topologyKey", "whenUnsatisfiable"],
      "properties": {
        "enabled": {"type": "boolean"},
        "maxSkew": {"type": "integer", "minimum": 1},
        "topologyKey": {"type": "string", "minLength": 1},
        "whenUnsatisfiable": {"enum": ["DoNotSchedule", "ScheduleAnyway"]}
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled", "ingressNamespaceSelector"],
      "properties": {
        "enabled": {"type": "boolean"},
        "ingressNamespaceSelector": {"type": "object", "minProperties": 1}
      }
    },
    "temporaryStorage": {
      "type": "object",
      "required": ["sizeLimit"],
      "properties": {"sizeLimit": {"type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi)$"}}
    }
  }
}
